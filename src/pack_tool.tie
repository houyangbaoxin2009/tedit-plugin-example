type tie<logic>
import "../../tlib/std/tzp.tie" as tzp
// src/pack_tool.tie —— .tedit 打包工具（tzp 容器）
// --------------------------------------------------------------
// 把 build/release 下的分发件组包为 .tedit（tzp 归档容器，rANS 熵层）：
//   plugin.zd          清单二进制形态（tiec --compress-data 产出）
//   plugin.data.tie    清单明文形态（人类可读对账）
//   LICENSE
// 包名约定：<id 的点换连字符>-<version>.tedit → example-greet-0.1.0.tedit。
// 在仓库根运行（相对路径以根为基准）。
//
// EN: packs the release files into example-greet-0.1.0.tedit (tzp container).
// Run from the repo root.

func main() -> i64 {
    var zd = file_read("build/release/plugin.zd")
    var mf = file_read("build/release/plugin.data.tie")
    var lic = file_read("build/release/LICENSE")
    var names = table_new_string()
    table_push(names, "plugin.zd")
    table_push(names, "plugin.data.tie")
    table_push(names, "LICENSE")
    var blobs = table_new_string()
    table_push(blobs, zd)
    table_push(blobs, mf)
    table_push(blobs, lic)
    var zp = tzp.tzp_pack(names, blobs, tzp.method_rans())
    if len(zp) == 0 {
        println("pack failed")
        return 1
    }
    var out = "build/release/example-greet-0.1.0.tedit"
    if !file_write(out, zp) {
        println("pack write failed: " + out)
        return 1
    }
    println("pack ok: " + out)
    return 0
}
