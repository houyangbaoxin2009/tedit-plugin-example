type tie<tsh>
// build.tsh.tie —— tedit-plugin-example (role tsh) build driver
// usage: <tshell>/src/tsh_main.exe -f build.tsh.tie
//        (set env TIE_BUILD_NOCACHE=1 to pass --no-cache to tiec)
// Requires sibling checkouts of this repo:
//   ../tiec/compiler/tiec.exe   (stage0 is enough)
//   ../tedit/src/*.tie          (kernel modules, imported by demo host)
// Outputs (build artifacts never live in src/):
//   build/demo/     demo bundle: demo_host.exe + plugin.data.tie
//   build/release/  distribution bundle: demo_host.exe + plugin.zd (binary
//                   manifest, tie:zd) + plugin.data.tie + LICENSE
// NOTE(exec-code-async): exec_code returns before the child process finishes
// (tsh p.9216 §4) — the exe copy is gated by a sleep_ms poll loop. tsh-role
// scripts have no file_copy (env bridge is logic-context only), so copies go
// through exec_code cmd copy.
// NOTE(tsh-limitation): the tsh interp cannot issue a conditional `exit N`,
// so on the tiec-missing / compile-fail path this logs the problem but the
// process still returns 0.
var root = cwd()
var tiec = path_join(root, "..\\tiec\\compiler\\tiec.exe")
if !file_exists(tiec) { println("[build] tiec stage0 not found: " + tiec) }
if !file_exists(tiec) { println("[build] please clone tie-lang/tiec as a sibling of this repo.") }
var opts = ""
if get_env("TIE_BUILD_NOCACHE") == "1" { opts = "--no-cache " }

// 轮询等待产物落盘（100ms × 上限 300 次 = 30s）。
func wait_for(p: string) -> bool {
    var spins = 0
    while spins < 300 {
        if file_exists(p) { return true }
        sleep_ms(100)
        spins = spins + 1
    }
    return false
}

mkdir_all("build/demo")
mkdir_all("build/release")

// 与编译无依赖的静态拷贝先行（manifest 进 demo/release，LICENSE 进 release）。
var rc0 = exec_code("cd /d \"" + root + "\" && copy /Y \"plugin.data.tie\" \"build\\demo\\plugin.data.tie\" >nul && copy /Y \"plugin.data.tie\" \"build\\release\\plugin.data.tie\" >nul && copy /Y \"LICENSE\" \"build\\release\\LICENSE\" >nul")
if rc0 != 0 { println("[build] static copy failed (rc=" + to_string(rc0) + ")") }

println("[build] compiling src/demo_host.tie -> build/demo/")
var rc1 = exec_code("cd /d \"" + root + "\" && ..\\tiec\\compiler\\tiec.exe " + opts + "\"src/demo_host.tie\" -o \"build\\demo\\demo_host.exe\"")
if rc1 != 0 { println("[build] compile failed: src/demo_host.tie (rc=" + to_string(rc1) + ")") }
if !wait_for("build/demo/demo_host.exe") { println("[build] timeout: build/demo/demo_host.exe") }

var rc3 = exec_code("cd /d \"" + root + "\" && copy /Y \"build\\demo\\demo_host.exe\" \"build\\release\\demo_host.exe\" >nul")
if rc3 != 0 { println("[build] exe copy failed (rc=" + to_string(rc3) + ")") }

println("[build] compressing plugin.data.tie -> build/release/plugin.zd")
var rc2 = exec_code("cd /d \"" + root + "\" && ..\\tiec\\compiler\\tiec.exe --compress-data \"plugin.data.tie\" -o \"build\\release\\plugin.zd\"")
if rc2 != 0 { println("[build] compress failed: plugin.data.tie (rc=" + to_string(rc2) + ")") }
if !wait_for("build/release/plugin.zd") { println("[build] timeout: build/release/plugin.zd") }

println("[build] done: build/demo -> demo_host.exe + plugin.data.tie; build/release -> demo_host.exe + plugin.zd + plugin.data.tie + LICENSE")
exit 0
